{
  "manifest_version": 3,
  "name": "Puppy's Pals: JanitorAI Chat Pets",
  "version": "1.0.0",
  "description": "Add a cute typing pet to your JanitorAI chat bar. Choose your companion and watch it follow along as you type.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting", "webNavigation"],
  "host_permissions": ["https://janitorai.com/chats/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Puppy's Pals: JanitorAI Chat Pets",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "manage.html", "open_in_tab": true },
  "content_scripts": [{
    "matches": ["https://janitorai.com/chats/*"],
    "js": ["pet-core.js", "typing-sounds.js", "content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["assets/*.png", "assets/sounds/*.mp3"],
    "matches": ["https://janitorai.com/*"]
  }]
}
